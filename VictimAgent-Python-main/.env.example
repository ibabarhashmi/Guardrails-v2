# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL=gpt-4o-mini
MAX_TOKENS=500
LLM_TIMEOUT_S=15
LLM_TEMPERATURE=0.2
# Comma-separated production API keys. Empty = dev mode (no auth).
PROD_API_KEYS=
# Research-only legacy oracle. Keep false unless red-teaming locally.
ENABLE_VICTIM=false
ENABLE_RATE_LIMIT=true
RATE_LIMIT=20/minute
# Comma-separated allowed CORS origins. Empty = no CORS.
CORS_ORIGINS=
ALLOW_HOSTS=*
MAX_BODY_BYTES=32768
LOG_LEVEL=INFO
